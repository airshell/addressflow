{
  "name": "@addressflow/api",
  "version": "0.1.0",
  "description": "AddressFlow REST API Server",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts --format esm --dts",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@addressflow/types": "workspace:*",
    "@addressflow/core": "workspace:*",
    "@addressflow/provider-base": "workspace:*",
    "@addressflow/provider-mock": "workspace:*",
    "@addressflow/provider-nominatim": "workspace:*",
    "@addressflow/provider-google": "workspace:*",
    "@addressflow/server": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2",
    "@addressflow/provider-mapbox": "workspace:*",
    "@addressflow/map-helpers": "workspace:*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}