# ==============================================================================
# AddressFlow Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# API Server Configuration
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://addressflow_user:addressflow_secret@localhost:5432/addressflow_db
DATABASE_MAX_CONNECTIONS=20

# Redis Cache & Lock Coordination
REDIS_URL=redis://localhost:6379

# Geocoding & Address Providers
# Google Maps Platform (Places New API & Geocoding API)
GOOGLE_MAPS_API_KEY=

# OpenStreetMap / Nominatim (100% Free / Open Source)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AddressFlow/0.1.0 (contact@addressflow.dev)

# Normalization & Request Coalescing
ADDRESS_NORMALIZATION_VERSION=v1
COALESCING_LOCK_TTL_MS=5000
COALESCING_TIMEOUT_MS=10000

# Rate Limiting Defaults (Per API Key / Project)
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
